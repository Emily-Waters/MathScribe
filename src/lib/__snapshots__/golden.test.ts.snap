exports[`the Reference tab’s examples > Solving: m_1 = 3.00 kg 1`] = `
"1: m_1 = 3.00 kg
2: m_2 = 5.00 kg
3: (T, a) = (36.8 N,\\ 2.45 m/s^2)
     ↳ T- m_1 g = m_1 a
     ↳ m_2 g- T = m_2 a
     ↳ a = \\frac(m_2- m_1) gm_1+ m_2 = \\frac(5.00 kg- 3.00 kg)\\times 9.81 m/s^23.00 kg+ 5.00 kg = 2.45 m/s^2
     ↳ T = m_1 a+ m_1 g = 3.00 kg\\times 2.45 m/s^2+ 3.00 kg\\times 9.81 m/s^2 = 36.8 N"
`;

exports[`the Reference tab’s examples > Solving: v = 5.00 m/s 1`] = `
"1: v = 5.00 m/s
2: a = 2.00 m/s^2
3: d = \\fracv^22 a = \\frac(5.00 m/s)^22\\times 2.00 m/s^2 = 6.25 m
     ↳ v^2 = 2 a d"
`;


exports[`golden sheets > hydrogen orbitals 1`] = `
"1: a_0 = 0.529 Å
     INFO Every @a_0 in this sheet uses this value, to 3 sig figs, in angstrom, unless written with its own :n.
3: \\psi_prob(r, \\psi) = 4 \\pi r^2 \\psi^2
4: \\sigma(Z, r [Å]) = \\fracZ ra_0
7: Z = 1
8: r = 0.400 Å
9: s = \\fracZ ra_0 = \\frac1\\times 0.400 Å0.529 Å = 0.756
10: \\psi = \\pi^-0.5 (\\fracZa_0)^\\frac32 e^- s = \\pi^-0.5 (\\frac10.529 Å)^\\frac32 e^- 0.756 = 0.688 Å^-1.5
11: P = 4 \\pi r^2 \\psi^2 = 4 \\pi\\times (0.400 Å)^2\\times (0.688 Å^-1.5)^2 = 0.953 Å^-1
12: shell = P\\times 0.010 Å = 0.953 Å^-1\\times 0.010 Å = 0.95 %
16: Z = 1
17: r = 3.500 Å
18: s = \\fracZ ra_0 = \\frac1\\times 3.500 Å0.529 Å = 6.62
19: \\psi_200 = (32 \\pi)^-0.5 (\\fracZa_0)^\\frac32 (2- s) e^\\frac- s2 = (32 \\pi)^-0.5 (\\frac10.529 Å)^\\frac32 (2- 6.62) e^\\frac- 6.622 = -0.0438 Å^-1.5
20: P = 4 \\pi r^2 \\psi_200^2 = 4 \\pi\\times (3.500 Å)^2\\times (-0.0438 Å^-1.5)^2 = 0.295 Å^-1
24: Z = 1
25: r = 3.000 Å
26: s = \\fracZ ra_0 = \\frac1\\times 3.000 Å0.529 Å = 5.67
27: \\theta = 0.00°
28: \\psi_210 = (32 \\pi)^-\\frac12 (\\fracZa_0)^\\frac32 s e^-\\fracs2 \\cos(\\theta) = (32 \\pi)^-\\frac12 (\\frac10.529 Å)^\\frac32\\times 5.67\\times e^-\\frac5.672 \\cos(0.00°) = 0.0863 Å^-1.5
29: P = 4 \\pi r^2 \\psi_210^2 = 4 \\pi\\times (3.000 Å)^2\\times (0.0863 Å^-1.5)^2 = 0.842 Å^-1"
`;

exports[`golden sheets > the sample sheet 1`] = `
"4: m = 2.00 kg
5: g = 9.81 m/s^2
6: \\theta = (30.0 ± 0.5)°
7: d = (3.50 ± 0.02) m
10: F_g = m g = 2.00 kg\\times 9.81 m/s^2 = 19.6 N
11: F_par = F_g \\sin(\\theta) = 19.6 N\\times \\sin(30.0°) = (9.81 ± 0.15) N
12: a = \\fracF_parm = \\frac9.81 N2.00 kg = (4.91 ± 0.07) m/s^2
15: v_f = \\sqrt2 a d = \\sqrt2\\times 4.91 m/s^2\\times 3.50 m = (5.86 ± 0.05) m/s
16: t = \\fracv_fa = \\frac5.86 m/s4.91 m/s^2 = (1.19 ± 0.01) s
17: E_k = \\frac12 m v_f^2 = \\frac12\\times 2.00 kg\\times (5.86 m/s)^2 = (34.3 ± 0.6) J
18: v_f = (21.09 ± 0.17) km/h
22: \\delta v_f = \\sqrt(\\frac\\partial v_f\\partial a \\delta a)^2 + (\\frac\\partial v_f\\partial d \\delta d)^2 = \\sqrt(\\fracd\\sqrt2 a d \\delta a)^2 + (\\fraca\\sqrt2 a d \\delta d)^2 = \\sqrt(\\frac3.50 m\\sqrt2\\times 4.91 m/s^2\\times 3.50 m\\times 0.07 m/s^2)^2 + (\\frac4.91 m/s^2\\sqrt2\\times 4.91 m/s^2\\times 3.50 m\\times 0.02 m)^2 = 0.05 m/s
23: \\frac\\delta v_fv_f = \\frac0.05 m/s5.86 m/s = 0.008
27: t_1 = 1.21 s
28: t_2 = 1.17 s
29: t_3 = 1.24 s
30: t_4 = 1.19 s
31: \\bart = \\frac14\\sum_i=1^4 t_i = \\fract_1 + t_2 + t_3 + t_44 = \\frac1.21 s + 1.17 s + 1.24 s + 1.19 s4 = (1.203 ± 0.015) s
32: n_t = 4
33: a_exp = \\frac2 d\\bart^2 = \\frac2\\times 3.50 m(1.203 s)^2 = (4.84 ± 0.12) m/s^2
37: KE(mass, speed) = \\frac12 mass· speed^2
38: E_bottom = \\frac12 m v_f^2 = \\frac12\\times 2.00 kg\\times (5.86 m/s)^2 = (34.3 ± 0.6) J
39: p(mass, speed) = mass· speed
40: p_bottom = m v_f = 2.00 kg\\times 5.86 m/s = (11.72 ± 0.09) kg· m/s
45: \\rho_w = 998 kg/m^3
47: P_water = \\rho_w g\\times 0.250 m = 998 kg/m^3\\times 9.81 m/s^2\\times 0.250 m = 2.45 kPa
48: E_photon = \\frach c532 nm = \\frac(6.63e-34 J· s)\\times (3.00e8 m/s)532 nm = 2.33 eV
52: d_stop = \\fracv_f^22 a = \\frac(5.86 m/s)^22\\times 4.91 m/s^2 = (3.500 ± 0.020) m
     ↳ v_f^2 = 2 a d_stop
53: h_0 = 2.00 m
54: t_fall = \\frac\\sqrtv_f^2+ 2 g h_0- v_fg = \\frac\\sqrt(5.86 m/s)^2+ 2\\times 9.81 m/s^2\\times 2.00 m- 5.86 m/s9.81 m/s^2 = (0.2771 ± 0.0015) s
     ↳ h_0 = \\frac12 g t_fall^2+ v_f t_fall
     INFO Also a solution: $t_{\\mathrm{fall}} = -1.47\\,\\mathrm{s}$. Give a guess to choose it: @solve(…, t_fall, guess).
59: \\theta = 45°
60: a = g \\sin(\\theta) = 9.81 m/s^2\\times \\sin(45°) = 6.9 m/s^2
61: v_f = \\sqrt2 a d = \\sqrt2\\times 6.9 m/s^2\\times 3.50 m = (6.968 ± 0.020) m/s
63: v_f = (5.86 ± 0.05) m/s"
`;

exports[`golden sheets > the sample sheet’s LaTeX export 1`] = `
"% Made with MathScribe
\\documentclass[11pt,a4paper,fleqn]{article}
\\usepackage[margin=2.5cm]{geometry}
\\usepackage{amsmath, amssymb}
% Long runs of equations may break across pages.
\\allowdisplaybreaks
\\usepackage{parskip}
\\usepackage{etoolbox}
% Less space around equations (re-applied whenever the font size changes).
\\newcommand{\\compactdisplays}{%
  \\setlength{\\abovedisplayskip}{4pt plus 2pt}%
  \\setlength{\\belowdisplayskip}{4pt plus 2pt}%
  \\setlength{\\abovedisplayshortskip}{0pt plus 2pt}%
  \\setlength{\\belowdisplayshortskip}{4pt plus 2pt}}
\\appto{\\normalsize}{\\compactdisplays}
\\appto{\\small}{\\compactdisplays}
\\compactdisplays
\\setlength{\\mathindent}{1em}
% An equation too wide for the line is set one = per row, lined up.
\\newsavebox{\\msfitbox}
\\newcommand{\\msfitfirst}[2]{#1}
\\newcommand{\\msfitsecond}[2]{#2}
\\newcommand{\\msfit}[2]{\\sbox{\\msfitbox}{$\\displaystyle #1$}%
  \\ifdim\\wd\\msfitbox>\\dimexpr\\linewidth-\\mathindent\\relax
  \\expandafter\\msfitsecond\\else\\expandafter\\msfitfirst\\fi{#1}{#2}}
% A line and its note side by side if they fit; else the note just under it.
\\newsavebox{\\msnoteeqbox}
\\newsavebox{\\msnotebox}
\\newdimen\\msnoteroom
\\newcommand{\\msnotesep}{\\\\[\\msnoteroom]}
\\newcommand{\\msnoted}[2]{\\sbox{\\msnoteeqbox}{$\\displaystyle #1$}\\sbox{\\msnotebox}{#2}%
  \\ifdim\\dimexpr\\wd\\msnoteeqbox+\\wd\\msnotebox+1em\\relax>\\dimexpr\\linewidth-\\mathindent\\relax
  \\expandafter\\msfitsecond\\else\\expandafter\\msfitfirst\\fi
  {\\global\\msnoteroom=0pt\\relax #1\\tag*{#2}}
  {\\global\\msnoteroom=0.5\\baselineskip\\relax #1\\\\*[-\\jot]{}\\tag*{#2}}}
\\usepackage{xcolor}
\\usepackage{mdframed}
% Blocks, functions and constants: a card with a bar on the left, as in MathScribe.
\\mdfdefinestyle{msblock}{linewidth=2pt, linecolor=gray!50, topline=false, rightline=false,
  bottomline=false, leftmargin=0pt, rightmargin=0pt, innerleftmargin=10pt, innerrightmargin=0pt,
  innertopmargin=4pt, innerbottommargin=6pt, skipabove=10pt, skipbelow=10pt,
  frametitlefont=\\bfseries, frametitleaboveskip=4pt, frametitlebelowskip=0pt}
% The working inside a function call: indented and a little smaller.
\\newenvironment{msworking}{\\par\\small\\addtolength{\\mathindent}{1.5em}}{\\par}

\\begin{document}

\\section{Block sliding down a ramp}

A block is released from rest on a frictionless incline.

\\begin{gather*}
  \\msnoted{m = 2.00\\,\\mathrm{kg}}{\\small\\itshape mass of block} \\msnotesep
  \\msnoted{g = 9.81\\,\\mathrm{m}/\\mathrm{s}^{2}}{\\small\\itshape gravitational acceleration} \\msnotesep
  \\msnoted{\\theta = \\left(30.0 \\pm 0.5\\right)^{\\circ}}{\\small\\itshape incline angle, measured} \\msnotesep
  \\msnoted{d = \\left(3.50 \\pm 0.02\\right)\\,\\mathrm{m}}{\\small\\itshape length of ramp, measured}
\\end{gather*}

\\subsection{Forces}

\\begin{gather*}
  \\msnoted{F_{g} = m g = 2.00\\,\\mathrm{kg}\\times 9.81\\,\\mathrm{m}/\\mathrm{s}^{2} = 19.6\\,\\mathrm{N}}{\\small\\itshape weight} \\msnotesep
  \\msnoted{F_{\\mathrm{par}} = F_{g} \\sin\\left(\\theta\\right) = 19.6\\,\\mathrm{N}\\times \\sin\\left(30.0^{\\circ}\\right) = \\left(9.81 \\pm 0.15\\right)\\,\\mathrm{N}}{\\small\\itshape component along the ramp} \\msnotesep
  \\msnoted{a = \\frac{F_{\\mathrm{par}}}{m} = \\frac{9.81\\,\\mathrm{N}}{2.00\\,\\mathrm{kg}} = \\left(4.91 \\pm 0.07\\right)\\,\\mathrm{m}/\\mathrm{s}^{2}}{\\small\\itshape acceleration}
\\end{gather*}

\\subsection{Motion}

\\begin{gather*}
  \\msnoted{v_{f} = \\sqrt{2 a d} = \\sqrt{2\\times 4.91\\,\\mathrm{m}/\\mathrm{s}^{2}\\times 3.50\\,\\mathrm{m}} = \\left(5.86 \\pm 0.05\\right)\\,\\mathrm{m}/\\mathrm{s}}{\\small\\itshape speed at the bottom} \\msnotesep
  \\msnoted{t = \\frac{v_{f}}{a} = \\frac{5.86\\,\\mathrm{m}/\\mathrm{s}}{4.91\\,\\mathrm{m}/\\mathrm{s}^{2}} = \\left(1.19 \\pm 0.01\\right)\\,\\mathrm{s}}{\\small\\itshape time on the ramp} \\msnotesep
  \\msnoted{E_{k} = \\frac{1}{2} m {v_{f}}^{2} = \\frac{1}{2}\\times 2.00\\,\\mathrm{kg}\\times {\\left(5.86\\,\\mathrm{m}/\\mathrm{s}\\right)}^{2} = \\left(34.3 \\pm 0.6\\right)\\,\\mathrm{J}}{\\small\\itshape kinetic energy at the bottom} \\msnotesep
  v_{f} = \\left(21.09 \\pm 0.17\\right)\\,\\mathrm{km}/\\mathrm{h}
\\end{gather*}

\\subsection{Uncertainty}

Values with pm carry an uncertainty; results combine them in quadrature.

\\begin{gather*}
  \\msnoted{\\msfit{\\delta v_{f} = \\sqrt{\\left(\\frac{\\partial v_{f}}{\\partial a}\\,\\delta a\\right)^{2} + \\left(\\frac{\\partial v_{f}}{\\partial d}\\,\\delta d\\right)^{2}} = \\sqrt{\\left(\\frac{d}{\\sqrt{2 a d}}\\,\\delta a\\right)^{2} + \\left(\\frac{a}{\\sqrt{2 a d}}\\,\\delta d\\right)^{2}} = \\sqrt{\\left(\\frac{3.50\\,\\mathrm{m}}{\\sqrt{2\\times 4.91\\,\\mathrm{m}/\\mathrm{s}^{2}\\times 3.50\\,\\mathrm{m}}}\\times 0.07\\,\\mathrm{m}/\\mathrm{s}^{2}\\right)^{2} + \\left(\\frac{4.91\\,\\mathrm{m}/\\mathrm{s}^{2}}{\\sqrt{2\\times 4.91\\,\\mathrm{m}/\\mathrm{s}^{2}\\times 3.50\\,\\mathrm{m}}}\\times 0.02\\,\\mathrm{m}\\right)^{2}} = 0.05\\,\\mathrm{m}/\\mathrm{s}}{\\begin{aligned}\\delta v_{f} &= \\sqrt{\\left(\\frac{\\partial v_{f}}{\\partial a}\\,\\delta a\\right)^{2} + \\left(\\frac{\\partial v_{f}}{\\partial d}\\,\\delta d\\right)^{2}} \\\\ &= \\sqrt{\\left(\\frac{d}{\\sqrt{2 a d}}\\,\\delta a\\right)^{2} + \\left(\\frac{a}{\\sqrt{2 a d}}\\,\\delta d\\right)^{2}} \\\\ &= \\sqrt{\\left(\\frac{3.50\\,\\mathrm{m}}{\\sqrt{2\\times 4.91\\,\\mathrm{m}/\\mathrm{s}^{2}\\times 3.50\\,\\mathrm{m}}}\\times 0.07\\,\\mathrm{m}/\\mathrm{s}^{2}\\right)^{2} + \\left(\\frac{4.91\\,\\mathrm{m}/\\mathrm{s}^{2}}{\\sqrt{2\\times 4.91\\,\\mathrm{m}/\\mathrm{s}^{2}\\times 3.50\\,\\mathrm{m}}}\\times 0.02\\,\\mathrm{m}\\right)^{2}} \\\\ &= 0.05\\,\\mathrm{m}/\\mathrm{s}\\end{aligned}}}{\\small\\itshape how the uncertainty in v\\textsubscript{f} is worked out} \\msnotesep
  \\msnoted{\\frac{\\delta v_{f}}{v_{f}} = \\frac{0.05\\,\\mathrm{m}/\\mathrm{s}}{5.86\\,\\mathrm{m}/\\mathrm{s}} = 0.008}{\\small\\itshape relative uncertainty}
\\end{gather*}

\\subsection{Repeated measurements}

Numbered variables form a series: t is their sum, t\\textsubscript{avg} the mean ± $\\sigma$/$\\surd$n.

\\begin{gather*}
  t_{1} = 1.21\\,\\mathrm{s} \\\\
  t_{2} = 1.17\\,\\mathrm{s} \\\\
  t_{3} = 1.24\\,\\mathrm{s} \\\\
  t_{4} = 1.19\\,\\mathrm{s} \\\\
  \\msnoted{\\msfit{\\bar{t} = \\frac{1}{4}\\sum_{i=1}^{4} t_{i} = \\frac{t_{1} + t_{2} + t_{3} + t_{4}}{4} = \\frac{1.21\\,\\mathrm{s} + 1.17\\,\\mathrm{s} + 1.24\\,\\mathrm{s} + 1.19\\,\\mathrm{s}}{4} = \\left(1.203 \\pm 0.015\\right)\\,\\mathrm{s}}{\\begin{aligned}\\bar{t} &= \\frac{1}{4}\\sum_{i=1}^{4} t_{i} \\\\ &= \\frac{t_{1} + t_{2} + t_{3} + t_{4}}{4} \\\\ &= \\frac{1.21\\,\\mathrm{s} + 1.17\\,\\mathrm{s} + 1.24\\,\\mathrm{s} + 1.19\\,\\mathrm{s}}{4} \\\\ &= \\left(1.203 \\pm 0.015\\right)\\,\\mathrm{s}\\end{aligned}}}{\\small\\itshape mean time down the ramp} \\msnotesep
  n_{t} = 4 \\\\
  \\msnoted{a_{\\mathrm{exp}} = \\frac{2 d}{{\\bar{t}}^{2}} = \\frac{2\\times 3.50\\,\\mathrm{m}}{{\\left(1.203\\,\\mathrm{s}\\right)}^{2}} = \\left(4.84 \\pm 0.12\\right)\\,\\mathrm{m}/\\mathrm{s}^{2}}{\\small\\itshape measured acceleration, with uncertainty}
\\end{gather*}

\\subsection{Functions}

A function is written the way it is in maths; values and uncertainties flow through it.

\\begin{gather*}
  \\mathrm{KE}\\left(\\mathrm{mass}, \\mathrm{speed}\\right) = \\frac{1}{2}\\,\\mathrm{mass}\\cdot {\\mathrm{speed}}^{2} \\\\
  \\msnoted{E_{\\mathrm{bottom}} = \\frac{1}{2} m {v_{f}}^{2} = \\frac{1}{2}\\times 2.00\\,\\mathrm{kg}\\times {\\left(5.86\\,\\mathrm{m}/\\mathrm{s}\\right)}^{2} = \\left(34.3 \\pm 0.6\\right)\\,\\mathrm{J}}{\\small\\itshape same as E\\textsubscript{k} above} \\msnotesep
  p\\left(\\mathrm{mass}, \\mathrm{speed}\\right) = \\mathrm{mass}\\cdot \\mathrm{speed} \\\\
  p_{\\mathrm{bottom}} = m v_{f} = 2.00\\,\\mathrm{kg}\\times 5.86\\,\\mathrm{m}/\\mathrm{s} = \\left(11.72 \\pm 0.09\\right)\\,\\mathrm{kg}\\cdot \\mathrm{m}/\\mathrm{s}
\\end{gather*}

\\subsection{Constants}

Built-in constants start with @ (3 sig figs unless you write @name:n or @name:exact).

\\begin{mdframed}[style=msblock, frametitle={Constants}]
\\begin{gather*}
  \\msnoted{\\rho_{w} = 998\\,\\mathrm{kg}/\\mathrm{m}^{3}}{\\small\\itshape water at 20 °C}
\\end{gather*}
\\end{mdframed}

\\begin{gather*}
  \\msnoted{P_{\\mathrm{water}} = \\rho_{w} g\\times 0.250\\,\\mathrm{m} = 998\\,\\mathrm{kg}/\\mathrm{m}^{3}\\times 9.81\\,\\mathrm{m}/\\mathrm{s}^{2}\\times 0.250\\,\\mathrm{m} = 2.45\\,\\mathrm{kPa}}{\\small\\itshape pressure 25 cm under water} \\msnotesep
  \\msnoted{E_{\\mathrm{photon}} = \\frac{h c}{532\\,\\mathrm{nm}} = \\frac{\\left(6.63 \\times 10^{-34}\\,\\mathrm{J}\\cdot \\mathrm{s}\\right)\\times \\left(3.00 \\times 10^{8}\\,\\mathrm{m}/\\mathrm{s}\\right)}{532\\,\\mathrm{nm}} = 2.33\\,\\mathrm{eV}}{\\small\\itshape green laser photon}
\\end{gather*}

\\subsection{Solving}

@solve(equation, unknown) rearranges the equation and evaluates the result.

\\begin{msworking}
\\begin{gather*}
  \\msnoted{{v_{f}}^{2} = 2 a d_{\\mathrm{stop}}}{\\small\\itshape solving for $d_{\\mathrm{stop}}$}
\\end{gather*}
\\end{msworking}
\\begin{gather*}
  \\msnoted{d_{\\mathrm{stop}} = \\frac{{v_{f}}^{2}}{2 a} = \\frac{{\\left(5.86\\,\\mathrm{m}/\\mathrm{s}\\right)}^{2}}{2\\times 4.91\\,\\mathrm{m}/\\mathrm{s}^{2}} = \\left(3.500 \\pm 0.020\\right)\\,\\mathrm{m}}{\\small\\itshape ramp length needed to reach v\\textsubscript{f}}
\\end{gather*}

\\begin{gather*}
  h_{0} = 2.00\\,\\mathrm{m}
\\end{gather*}

\\begin{msworking}
\\begin{gather*}
  \\msnoted{h_{0} = \\frac{1}{2} g {t_{\\mathrm{fall}}}^{2}+ v_{f} t_{\\mathrm{fall}}}{\\small\\itshape solving for $t_{\\mathrm{fall}}$}
\\end{gather*}
\\end{msworking}
\\begin{gather*}
  \\msnoted{\\msfit{t_{\\mathrm{fall}} = \\frac{\\sqrt{{v_{f}}^{2}+ 2 g h_{0}}- v_{f}}{g} = \\frac{\\sqrt{{\\left(5.86\\,\\mathrm{m}/\\mathrm{s}\\right)}^{2}+ 2\\times 9.81\\,\\mathrm{m}/\\mathrm{s}^{2}\\times 2.00\\,\\mathrm{m}}- 5.86\\,\\mathrm{m}/\\mathrm{s}}{9.81\\,\\mathrm{m}/\\mathrm{s}^{2}} = \\left(0.2771 \\pm 0.0015\\right)\\,\\mathrm{s}}{\\begin{aligned}t_{\\mathrm{fall}} &= \\frac{\\sqrt{{v_{f}}^{2}+ 2 g h_{0}}- v_{f}}{g} \\\\ &= \\frac{\\sqrt{{\\left(5.86\\,\\mathrm{m}/\\mathrm{s}\\right)}^{2}+ 2\\times 9.81\\,\\mathrm{m}/\\mathrm{s}^{2}\\times 2.00\\,\\mathrm{m}}- 5.86\\,\\mathrm{m}/\\mathrm{s}}{9.81\\,\\mathrm{m}/\\mathrm{s}^{2}} \\\\ &= \\left(0.2771 \\pm 0.0015\\right)\\,\\mathrm{s}\\end{aligned}}}{\\small\\itshape quadratic: positive root}
\\end{gather*}

\\subsection{What if?}

Variables assigned inside a block are local to it, like a scoped block in code.

\\begin{mdframed}[style=msblock, frametitle={Steeper ramp --- outer values are readable, and can be shadowed}]
\\begin{gather*}
  \\msnoted{\\theta = 45^{\\circ}}{\\small\\itshape 2 sig figs, so results here have 2} \\msnotesep
  a = g \\sin\\left(\\theta\\right) = 9.81\\,\\mathrm{m}/\\mathrm{s}^{2}\\times \\sin\\left(45^{\\circ}\\right) = 6.9\\,\\mathrm{m}/\\mathrm{s}^{2} \\\\
  v_{f} = \\sqrt{2 a d} = \\sqrt{2\\times 6.9\\,\\mathrm{m}/\\mathrm{s}^{2}\\times 3.50\\,\\mathrm{m}} = \\left(6.968 \\pm 0.020\\right)\\,\\mathrm{m}/\\mathrm{s}
\\end{gather*}
\\end{mdframed}

\\begin{gather*}
  \\msnoted{v_{f} = \\left(5.86 \\pm 0.05\\right)\\,\\mathrm{m}/\\mathrm{s}}{\\small\\itshape unchanged outside the block}
\\end{gather*}

\\end{document}
"
`;


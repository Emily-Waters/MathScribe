"1: \\theta = 0.00°
2: c = \\cos(\\theta) = \\cos(0.00°) = 1"
`;

exports[`the Reference tab’s examples > Significant figures: third:3 = 1/3 1`] = `"1: third = \\frac13 ≈ 0.333"`;

exports[`the Reference tab’s examples > Significant figures: third:exact = 1/3 1`] = `"1: third = \\frac13 ≈ 0.333333"`;

exports[`the Reference tab’s examples > Solving: v = 5.00 m/s 1`] = `
"1: v = 5.00 m/s
2: a = 2.00 m/s^2
3: d = \\fracv^22 a = \\frac(5.00 m/s)^22 (2.00 m/s^2) = 6.25 m
     ↳ v^2 = 2 a d"
`;

exports[`the Reference tab’s examples > Tuples and coordinates: p = tuple(1.414 m, 0.7854) 1`] = `
"1: p = (1.414 m, 0.7854)
2: (r, \\theta) = p = (1.41 m, 45.00°)
3: x = r \\cos(\\theta) = (1.41 m) \\cos(45.00°) = 1.00 m"
`;

exports[`the Reference tab’s examples > Tuples and coordinates: r = tuple(1.00 m, 2.00 m, 3.00 m) 1`] = `
"1: r = (1.00 m, 2.00 m, 3.00 m) = (1.00, 2.00, 3.00) m
2: s = 2 r = 2 (1.00, 2.00, 3.00) m = (2.00, 4.00, 6.00) m
3: d = \\left\\| r\\right\\| = \\left\\| (1.00, 2.00, 3.00) m\\right\\| = 3.74 m"
`;

exports[`the Reference tab’s examples > Uncertainty: d = 3.50 m pm 0.02 m 1`] = `"1: d = (3.50 ± 0.02) m"`;

exports[`the Reference tab’s examples > Uncertainty: d = 3.50 m pm 0.02 m 2`] = `
"1: d = (3.50 ± 0.02) m
2: t = (1.21 ± 0.03) s
3: v = \\fracdt = \\frac3.50 m1.21 s = (2.89 ± 0.07) m/s
4: \\delta v = \\sqrt(\\frac\\partial v\\partial d· \\delta d)^2 + (\\frac\\partial v\\partial t· \\delta t)^2 = \\sqrt(\\frac1t· \\delta d)^2 + [(-\\fracdt^2)· \\delta t]^2 = \\sqrt(\\frac11.21 s· 0.02 m)^2 + ❴[-\\frac3.50 m(1.21 s)^2]· 0.03 s❵^2 = 0.07 m/s
5: \\frac\\delta vv = \\frac0.07 m/s2.89 m/s = 0.03"
`;

exports[`the Reference tab’s examples > Uncertainty: m = 2.00 kg pm 2% 1`] = `"1: m = 2.00 kg ± 2%"`;

